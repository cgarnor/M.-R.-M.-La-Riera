{
  "name": "mrm-analysis-tool",
  "productName": "MRM Analysis Tool",
  "private": true,
  "version": "1.0.0",
  "description": "Morphological Residue Model (MRM) and residual roughness (Rqr) for 3D models of archaeological artefacts",
  "author": "Carlos García-Noriega <carlos.garcianoriega@unican.es>",
  "contributors": [
    "Pablo Arias <pablo.arias@unican.es>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cgarnor/M.-R.-M.-La-Riera",
  "repository": {
    "type": "git",
    "url": "https://github.com/cgarnor/M.-R.-M.-La-Riera.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host=127.0.0.1",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx validation/engine-tests.ts",
    "test:e2e": "vite build && electron validation/e2e-electron.cjs",
    "validate:cloudcompare": "tsx validation/cloudcompare-compare.ts",
    "electron:dev": "vite build && electron .",
    "electron:build": "npm run lint && npm test && vite build && electron-builder --win --x64",
    "electron:build:dir": "vite build && electron-builder --win --x64 --dir",
    "test:packaged": "node validation/e2e-packaged.mjs"
  },
  "build": {
    "appId": "com.mrm.analysis-tool",
    "productName": "MRM Analysis Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-helpers.cjs",
      "preload.cjs",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "native/win-x64",
        "to": "bin"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MRM-Analysis-Tool-Setup-${version}.${ext}"
    },
    "forceCodeSigning": false,
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.1",
    "lucide-react": "^0.546.0",
    "meshoptimizer": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "three-mesh-bvh": "^0.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.1",
    "minimatch@^10.0.0": "^11.0.1"
  }
}
